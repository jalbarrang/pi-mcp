{
  "name": "@dreki-gg/pi-mcp",
  "version": "0.1.0",
  "description": "MCP client extension for pi",
  "keywords": ["pi-package"],
  "license": "MIT",
  "type": "module",
  "files": ["extensions", "!extensions/mcp/__tests__", "bin", "README.md", "CHANGELOG.md", "package.json"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint extensions bin",
    "format": "oxfmt --write extensions bin",
    "format:check": "oxfmt --check extensions bin",
    "test": "node bin/check-file-length.js && tsc --noEmit && bun test extensions/mcp/__tests__"
  },
  "pi": {"extensions": ["./extensions/mcp"]},
  "dependencies": {"@modelcontextprotocol/sdk": "^1.0.0"},
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "@earendil-works/pi-tui": "^0.80.7",
    "@types/node": "24",
    "bun-types": "latest",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typebox": "^1.0.0",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {"@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*", "typebox": "*"},
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {"optional": true},
    "@earendil-works/pi-tui": {"optional": true},
    "typebox": {"optional": true}
  }
}
